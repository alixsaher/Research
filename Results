import numpy as np
import matplotlib.pyplot as plt

# Create a figure with two subplots side-by-side, AES first
fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(12, 5), sharey=True)

# Common noise levels
noise_levels = np.linspace(0, 10, 200)
noise_levels_aes = noise_levels / 10  # Normalize for AES formulas

# Define consistent colors
colors = {
    'brute_force': "#6699be",
    'grover': "#629162",
    'side_leak': "#b51f1f",
    'channel_noise': "#e58734",
    'decoherence': "#e8349a"
}

# --- AES-only System ---
qber_brute_force_aes = 0.01 + 0.05 * noise_levels_aes
qber_grover_aes = 0.02 + 0.1 * np.sqrt(noise_levels_aes)
qber_side_leak_aes = 0.03 + 0.15 * noise_levels_aes
qber_channel_noise_aes = 0.05 * noise_levels_aes**2
qber_decoherence_aes = np.full_like(noise_levels_aes, 0.01)

ax1.plot(noise_levels, qber_brute_force_aes, label='Classical Brute Force', linewidth=2, color=colors['brute_force'])
ax1.plot(noise_levels, qber_grover_aes, label="Grover's Attack", linewidth=2, color=colors['grover'])
ax1.plot(noise_levels, qber_side_leak_aes, label='Brute Force + Side Leak', linewidth=2, color=colors['side_leak'])
ax1.plot(noise_levels, qber_channel_noise_aes, label='Channel Noise', linewidth=2, color=colors['channel_noise'])
ax1.plot(noise_levels, qber_decoherence_aes, label='Decoherence (N/A)', linestyle='--', linewidth=2, color=colors['decoherence'])
ax1.axhline(y=0.11, color='black', linestyle='--', linewidth=1, label='Eve Detection Threshold (11%)')

ax1.set_title('AES-only System', fontsize=12)
ax1.set_xlabel('Noise / Attack Strength (0 to 10)', fontsize=9)
ax1.set_ylabel('Quantum Bit Error Rate (QBER)', fontsize=9)
ax1.grid(True, linestyle='--', alpha=0.5)
ax1.text(5, 0.5, 'AES', fontsize=30, color='gray', alpha=0.2, ha='center', va='center', rotation=15)
ax1.legend(fontsize=8)
ax1.set_ylim(0, 1)

# --- QuLoRa ---
def qber_brute_force(n): return np.clip(0.01 + 0.01 * n, 0, 1)
def qber_grover(n): return np.clip(0.02 + 0.03 * np.sqrt(n), 0, 1)
def qber_brute_force_side_leak(n): return np.clip(0.02 + 0.04 * n, 0, 1)
def qber_channel_noise(n): return np.clip(0.01 + 0.02 * n**1.5, 0, 1)
def qber_decoherence(n): return np.clip(0.01 * np.exp(0.4 * n), 0, 1)

qber_bf_qulora = qber_brute_force(noise_levels)
qber_gv_qulora = qber_grover(noise_levels)
qber_bf_leak_qulora = qber_brute_force_side_leak(noise_levels)
qber_noise_qulora = qber_channel_noise(noise_levels)
qber_dec_qulora = qber_decoherence(noise_levels)

ax2.plot(noise_levels, qber_bf_qulora, label='Classical Brute Force', linewidth=2, color=colors['brute_force'])
ax2.plot(noise_levels, qber_gv_qulora, label="Grover's Attack", linewidth=2, color=colors['grover'])
ax2.plot(noise_levels, qber_bf_leak_qulora, label='Brute Force + Side Leak', linewidth=2, color=colors['side_leak'])
ax2.plot(noise_levels, qber_noise_qulora, label='Quantum Channel Noise', linewidth=2, color=colors['channel_noise'])
ax2.plot(noise_levels, qber_dec_qulora, label='Decoherence', linewidth=2, color=colors['decoherence'])
ax2.axhline(y=0.11, color='black', linestyle='--', linewidth=1)

ax2.set_title('QuLoRa', fontsize=12)
ax2.set_xlabel('Noise / Attack Strength (0 to 10)', fontsize=9)
ax2.grid(True, linestyle='--', alpha=0.5)
ax2.text(5, 0.5, 'QuLoRa', fontsize=30, color='gray', alpha=0.2, ha='center', va='center', rotation=15)
ax2.legend(fontsize=8)

# Finalize and save
plt.tight_layout()
plt.savefig('qber_comparison_symmetric.png', dpi=300)
plt.show()
